    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sector -->

    <owl:Class rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sector">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_estat_energia"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Estat_Energia"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_panell"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Panell"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_sensor"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sensor"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_cultiu"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Cultiu"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_sensor"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sensor_Humitat_Sol"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_sensor"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sensor_Pluja"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_sensor"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sensor_Radiacio"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_sensor"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sensor_Temperatura_Aire"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_sensor"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sensor_Temperatura_Cultiu"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_sensor"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sensor_Vent"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


