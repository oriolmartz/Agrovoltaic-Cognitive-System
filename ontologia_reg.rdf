    <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:minInclusive>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2a59294cc8fc43b1b190e6654db01438">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Hora"/>
