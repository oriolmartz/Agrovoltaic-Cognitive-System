  </rdf:Description>
  <rdf:Description rdf:nodeID="N2d5a832ec76b4eb4817ef1f55c9d4d2c">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
    <rdf:first>seleccionat</rdf:first>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#AVR1_Pluja_Prevista">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Font_Preferencia_Reg"/>
    <Codi_Font>AVR1-pluja-prevista</Codi_Font>
    <Exempta_Per_Nivell>critic</Exempta_Per_Nivell>
    <rdfs:comment xml:lang="ca">Restricció dura (rebuig). Si es preveu pluja &gt;= Pluja_Anulla_Mm (10 mm) a la Prediccio_Pluja del sector, es rebutgen regar-parcial i regar-complet, llevat que la necessitat sigui crítica. Font: Diputació de Barcelona.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nce2d6efc818f4c59b96f6dcd9972c25c">
    <rdf:first rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Preferencia_Rebuig"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Nivell_Necessitat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Necessitat_Reg"/>
    <rdfs:range rdf:nodeID="Nf68a3fe793e34f6482bedcf7caf001b0"/>
    <rdfs:comment xml:lang="ca">Nivell de necessitat de reg. Ordinal usat a AVR2: anticipada 1, mitja 2, alt 3, critic 4. Llindars: anticipada si esgotament &gt;= Anticipacio x p sense estrès; mitja si p &lt; e &lt;= p + t; alt si p + t &lt; e &lt;= p + 2t; critic altrament, amb t = (1 - p)/3 i marge de 1e-9.</rdfs:comment>
    <rdfs:label xml:lang="ca">nivell de necessitat</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Anticipacio">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Configuracio_Reg"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:comment xml:lang="ca">Fracció de p a partir de la qual es pot anticipar el reg (FAO-56: regar abans o en el moment que s'esgota l'aigua fàcilment disponible, RAW = p x TAW).</rdfs:comment>
    <rdfs:label xml:lang="ca">anticipació</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne594719520644ef09bf4fa3cb7fe0345">
    <rdf:first rdf:nodeID="Nb544675ef6d1496f8c6f971f5bb7e9cd"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Operador_Reg">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Fet_Reg_Accio"/>
    <rdfs:subClassOf rdf:nodeID="N966b19092d3542ec9b87f92972f8cec8"/>
    <rdfs:comment xml:lang="ca">Candidat d'acció de reg per a un sector i cicle (equivalent a un operador de SOAR; plantilla CLIPS operador-reg). La dosi és l'aigua neta afegida, en % de l'aigua disponible (TAW). Mai supera el que falta per arribar a capacitat de camp (FAO-56: la resta es perdria per percolació).</rdfs:comment>
    <rdfs:label xml:lang="ca">Operador de reg</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne71766df86874d31ba86beb825728876">
    <rdf:first rdf:nodeID="N24e14bf560d949ae8986f80f7f42b615"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Esgotament">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Necessitat_Reg"/>
    <rdfs:range rdf:nodeID="N9f76bdb0684d4d40b53a5f657e4c0738"/>
    <rdfs:comment xml:lang="ca">Fracció de l'aigua disponible (TAW) ja gastada: max(0, 1 - humitat-sol/100).</rdfs:comment>
    <rdfs:label xml:lang="ca">esgotament</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Valvula_Reg">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="ca">Actuador de reg per degoteig d'un sector. soar.clp no en té cap fet: l'ordre s'adreça «a la vàlvula de reg del sector». Si el model RDF encara no en declara, l'ordre queda sense destinatari explícit.</rdfs:comment>
    <rdfs:label xml:lang="ca">Vàlvula de reg</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#te_valvula_reg">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaDomini#te_component"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaDomini#Sector"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Valvula_Reg"/>
    <rdfs:comment xml:lang="ca">Sector -&gt; Valvula_Reg. Subpropietat de dom:te_component (com te_panell); la inversa dom:pertany_sector s'infereix.</rdfs:comment>
    <rdfs:label xml:lang="ca">té vàlvula de reg</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nfaec27d12f61423a853575c8721c995c">
    <rdf:first rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Preferencia_Acceptable"/>
    <rdf:rest rdf:nodeID="Nde8c77071cf045a3998ac0ce69ff626c"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Dosi">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Fet_Reg_Accio"/>
    <rdfs:range rdf:nodeID="N8a7ff545531e46f88e40c4bea88048cf"/>
    <rdfs:comment xml:lang="ca">Aigua neta afegida, en % de l'aigua disponible (TAW). OWL no pot expressar que no superi 100 x esgotament; ho garanteix proposa-dosis-reg.</rdfs:comment>
    <rdfs:label xml:lang="ca">dosi</rdfs:label>
  </rdf:Description>
