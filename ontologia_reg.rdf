>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Estat_Operador">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Operador_Reg"/>
    <rdfs:range rdf:nodeID="N97b53b39cec14ffb8fe81684c6fe68a1"/>
    <rdfs:comment xml:lang="ca">Cicle de vida d'un operador de reg.</rdfs:comment>
    <rdfs:label xml:lang="ca">estat de l'operador</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ncc6038df377342e2ac2ab7f751da6ef5">
    <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</xsd:minInclusive>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#RG2_Regar_Complet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Font_Preferencia_Reg"/>
    <Codi_Font>RG2</Codi_Font>
    <rdfs:comment xml:lang="ca">Proposta. regar-complet és acceptable amb estrès hídric (proposa-regar) o amb necessitat anticipada a hora fresca i sensibilitat no baixa (proposa-regar-anticipat). Amb degoteig es pot regar a qualsevol hora si hi ha estrès (Penn State Extension). La vinya (sensibilitat baixa) no s'anticipa: un estrès moderat li va bé (reg deficitari controlat, AWRI).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N3eeacf416fdb4504b8b5cab1309b45cc">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#sobre_operador"/>
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nef546827f59e42628edcd9f4aa28ebd2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Dosi"/>
    <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</owl:hasValue>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N531940700c464e878544305da9991167">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="N2efe20ab0d88435e9bf7913e3c79a5bf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Preferencia_Numerica">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N6fc5986a83ac46e695ff61d1a8a2d107"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Preferencia_Reg"/>
    <rdfs:subClassOf rdf:nodeID="N9a1778a808b54bc7b7f8040599d53c24"/>
    <rdfs:comment xml:lang="ca">Restricció tova amb valor. La puntuació d'un operador és la suma dels seus valors (funció puntuacio-reg).</rdfs:comment>
    <rdfs:label xml:lang="ca">Preferència numèrica</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Preferencia_Reg">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Fet_Reg_Cicle"/>
    <rdfs:subClassOf rdf:nodeID="N3eeacf416fdb4504b8b5cab1309b45cc"/>
    <rdfs:subClassOf rdf:nodeID="N87b042c1af984773966a886fc61b7b27"/>
    <rdfs:subClassOf rdf:nodeID="N1ad4b39393674409a94dbbdbdceb3780"/>
    <rdfs:comment xml:lang="ca">Valoració d'un operador de reg (plantilla CLIPS preferencia-reg). A diferència del panell, el reg només té tres tipus: acceptable, rebuig i numerica.</rdfs:comment>
    <rdfs:label xml:lang="ca">Preferència de reg</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf6edbca527d041d0aba7e10db4e749dd">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#tria_operador"/>
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#envia_a_valvula">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Ordre_Reg"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Valvula_Reg"/>
    <rdfs:comment xml:lang="ca">Vàlvula de reg destinatària de l'ordre.</rdfs:comment>
    <rdfs:label xml:lang="ca">s'envia a la vàlvula</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N15449aa5f6484002ae5d0d6b12f0eb0c">
    <rdf:first rdf:nodeID="N0f2e8b917b304f2faeb9806e23fe5527"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#AVR7_Estalvi">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Font_Preferencia_Reg"/>
    <serveix_objectiu rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Obj_Estalvi_Aigua"/>
    <Codi_Font>AVR7-estalvi</Codi_Font>
    <rdfs:comment xml:lang="ca">Valor = pes de l'objectiu estalvi d'aigua (1), només a no-regar i amb l'objectiu actiu.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nf75e42fbae1e49a384db88765b985345">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
    <rdf:first>mitja</rdf:first>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#explica_ordre">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Explicacio_Reg"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Ordre_Reg"/>
    <rdfs:comment xml:lang="ca">Ordre que justifica el text.</rdfs:comment>
    <rdfs:label xml:lang="ca">explica l'ordre</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Reg_Seleccionat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Decisio_Reg"/>
    <rdfs:subClassOf rdf:nodeID="Nf6edbca527d041d0aba7e10db4e749dd"/>
    <rdfs:comment xml:lang="ca">Operador de reg guanyador d'un sector i cicle (plantilla CLIPS reg-seleccionat; 1 cicle de persistència). Procediment: es descarten els rebutjats, es tria la puntuació més alta i, si hi ha empat, guanya el de dosi menor (objectiu d'estalvi d'aigua). Per això el reg no té impasses.</rdfs:comment>
    <rdfs:label xml:lang="ca">Reg seleccionat</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#te_font">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Preferencia_Reg"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Font_Preferencia_Reg"/>
    <rdfs:comment xml:lang="ca">Regla que ha generat la preferència.</rdfs:comment>
    <rdfs:label xml:lang="ca">té font</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#executa_seleccio">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Ordre_Reg"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Reg_Seleccionat"/>
    <rdfs:comment xml:lang="ca">Selecció de la qual surt l'ordre.</rdfs:comment>
    <rdfs:label xml:lang="ca">executa selecció</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Ordre_Reg">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Decisio_Reg"/>
    <rdfs:subClassOf rdf:nodeID="N4a31a86e80cb4bd9bb2c03bcd408b8dd"/>
    <rdfs:comment xml:lang="ca">Ordre enviada a la vàlvula del sector (plantilla CLIPS ordre-reg). Persisteix fins que el simulador la consumeix. Les ordres no-regar existeixen però no s'imprimeixen.</rdfs:comment>
    <rdfs:label xml:lang="ca">Ordre de reg</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc54bac94b3364256a0b9ec7c1967456e">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
    <rdf:first>rebutjat</rdf:first>
    <rdf:rest rdf:nodeID="N2d5a832ec76b4eb4817ef1f55c9d4d2c"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N7a64a2776f2d4c498f51683fbc0ce901">
    <rdf:first rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#AVR4_Hora_Fresca"/>
    <rdf:rest rdf:nodeID="N191eea43bc6b42318dfd1ef41325ec18"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#sobre_operador">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Preferencia_Reg"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Operador_Reg"/>
    <rdfs:comment xml:lang="ca">Operador valorat. A CLIPS és el nom de l'acció més sector i cicle; aquí és l'operador concret que identifiquen.</rdfs:comment>
    <rdfs:label xml:lang="ca">sobre operador</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#AVR6_Bomba">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Font_Preferencia_Reg"/>
    <serveix_objectiu rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaDomini#Obj_Produccio_Energia"/>
    <Codi_Font>AVR6-bomba</Codi_Font>
    <Valor_Fix rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-1.0</Valor_Fix>
    <rdfs:comment xml:lang="ca">-1 si l'objectiu d'energia és actiu i la producció del sector no cobreix la demanda (Estat_Energia): la bomba gasta energia (0,28-0,68 kWh/m3, Hardy i Garrido). Conflicte cultiu contra energia.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nbfbe41336ee24eafb2d9aed034c5af35">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
    <rdf:first>alt</rdf:first>
    <rdf:rest rdf:nodeID="N7558b92e8dcd474685f22cc88b24bd7a"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Preferencia_Acceptable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N4b706b71af6a48f3b3d1045bc6b33dd7"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Preferencia_Reg"/>
    <rdfs:comment xml:lang="ca">L'operador és candidat. La generen les regles de proposta (RG1, RG2, RG3).</rdfs:comment>
    <rdfs:label xml:lang="ca">Preferència acceptable</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#AVR5_Pluja_Moderada">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Font_Preferencia_Reg"/>
    <Codi_Font>AVR5-pluja</Codi_Font>
    <Valor_Fix rdf:datatype="http://www.w3.org/2001/XMLSchema#double">-3.0</Valor_Fix>
    <rdfs:comment xml:lang="ca">-3 a regar-complet si es preveu pluja &gt;= Pluja_Minima_Mm (2 mm): no cal omplir el sol, l'aigua de més es perdria.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#deriva_de">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Necessitat_Reg"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaDomini#Observacio_Humitat_Sol"/>
    <rdfs:comment xml:lang="ca">Lectura d'humitat del sol de la qual es deriva la necessitat (esgotament = 1 - Valor/100).</rdfs:comment>
    <rdfs:label xml:lang="ca">deriva de</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Preferencia_Rebuig">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N5c0b706381ac4421afe3840f9c807241"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Preferencia_Reg"/>
    <rdfs:comment xml:lang="ca">Restricció dura: l'operador queda descartat. Només la genera AVR1 (pluja prevista).</rdfs:comment>
    <rdfs:label xml:lang="ca">Preferència de rebuig</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Cicle_Reg">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Fet_Reg_Cicle"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="ca">Cicle de decisió. dom:Cicle només s'aplica a Estat, Observacio, Prediccio i Risc; per això el motor de decisió usa aquesta.</rdfs:comment>
    <rdfs:label xml:lang="ca">cicle (decisió de reg)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Explicacio_Reg">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Fet_Reg_Cicle"/>
    <rdfs:subClassOf rdf:nodeID="N383c134cf6624beb9bb7817892b82b1f"/>
    <rdfs:comment xml:lang="ca">Justificació en text d'una ordre de reg: necessitat, candidats amb puntuació, descartats i criteri (plantilla CLIPS explicacio-reg). Només s'escriu quan ja hi ha ordre.</rdfs:comment>
    <rdfs:label xml:lang="ca">Explicació del reg</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Hora_Fresca_Tarda">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Configuracio_Reg"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="ca">És fresca l'hora h amb h &gt;= aquest valor (Diputació de Barcelona).</rdfs:comment>
    <rdfs:label xml:lang="ca">primera hora fresca de la tarda</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N0f2e8b917b304f2faeb9806e23fe5527">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Tipus_Preferencia"/>
    <owl:hasValue>rebuig</owl:hasValue>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#RG3_Regar_Parcial">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Font_Preferencia_Reg"/>
    <Codi_Font>RG3</Codi_Font>
    <rdfs:comment xml:lang="ca">Proposta. regar-parcial és acceptable sempre que la dosi calculada sigui positiva.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nad0cc24066c2424bbdb674e82fa6fdd6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="N65e39839a1d84f75ae19a01b72d455e3"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nc4e6ebe8b530475c81aa5581e839f2b9">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#sobre_sector"/>
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#AVR4_Hora_Fresca">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Font_Preferencia_Reg"/>
    <Codi_Font>AVR4-hora</Codi_Font>
    <Valor_Fix rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</Valor_Fix>
    <rdfs:comment xml:lang="ca">+1 per regar a hora fresca: es perd menys aigua per evaporació (Diputació de Barcelona; Clemson).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nefa21abbd2de40c2b83b8f8153400c31">
    <rdf:first rdf:nodeID="Nd04a0ca278c24ed8bb68707ee3059411"/>
