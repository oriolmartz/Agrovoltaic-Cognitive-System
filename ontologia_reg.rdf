    <owl:intersectionOf rdf:nodeID="N6d9bb84a00e34e768b5e0bbedf68fe87"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Hora_Fresca_Mati">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Configuracio_Reg"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="ca">És fresca l'hora h amb h &lt;= aquest valor (Diputació de Barcelona).</rdfs:comment>
    <rdfs:label xml:lang="ca">última hora fresca del matí</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Fet_Reg_Cicle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:nodeID="Nc4e6ebe8b530475c81aa5581e839f2b9"/>
    <rdfs:subClassOf rdf:nodeID="N4784fca8e6724e0e9604430d24043345"/>
    <rdfs:comment xml:lang="ca">Fet del procés de decisió del reg, indexat per sector i cicle com els fets de decisió de soar.clp. A diferència de dom:Cicle (només Estat, Observacio, Prediccio i Risc), aquests fets són del motor de decisió i usen Cicle_Reg.</rdfs:comment>
    <rdfs:label xml:lang="ca">Fet de decisió de reg</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Fet_Reg_Accio">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Fet_Reg_Cicle"/>
    <rdfs:subClassOf rdf:nodeID="N01b6f16d6d4a4c6987dca61956143aa2"/>
    <rdfs:comment xml:lang="ca">Superclasse d'operador, selecció i ordre: tots porten una acció de reg i una dosi.</rdfs:comment>
    <rdfs:label xml:lang="ca">Fet de reg amb acció i dosi</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Tipus_Preferencia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Preferencia_Reg"/>
    <rdfs:range rdf:nodeID="N9bf1c897cf8746aabd857bc77b907ab2"/>
    <rdfs:comment xml:lang="ca">acceptable (candidat), rebuig (restricció dura) o numerica (restricció tova).</rdfs:comment>
    <rdfs:label xml:lang="ca">tipus de preferència</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N5ace4d40d3eb40cca11e4ef3b2796304">
