    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="ca">Paràmetres estàtics del criteri de reg (plantilla CLIPS reg-config).</rdfs:comment>
    <rdfs:label xml:lang="ca">Configuració del reg</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N3923fc6509d24e0d843de632e34be227">
