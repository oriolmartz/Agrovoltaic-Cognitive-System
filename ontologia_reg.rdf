  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Hora">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Observacio_Hora"/>
    <rdfs:range rdf:nodeID="Na7031492f3604756a06b33673803a16a"/>
    <rdfs:comment xml:lang="ca">Hora local, entre 0 i 23.</rdfs:comment>
    <rdfs:label xml:lang="ca">hora</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Valor_Preferencia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Preferencia_Reg"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:comment xml:lang="ca">Valor de la restricció tova.</rdfs:comment>
    <rdfs:label xml:lang="ca">valor de la preferència</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Accio_Reg">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Fet_Reg_Accio"/>
    <rdfs:range rdf:nodeID="N6f44418bafb4447bb49a31a390366f0d"/>
    <rdfs:comment xml:lang="ca">no-regar és sempre una opció; regar-complet torna el sol a capacitat de camp; regar-parcial el deixa a mig camí del llindar d'estrès (esgotament = p/2). Slot nom d'operador-reg i reg-seleccionat, i accio d'ordre-reg.</rdfs:comment>
    <rdfs:label xml:lang="ca">acció de reg</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N57d4f29d95e84ff789e66a39a518883f">
    <rdf:first rdf:nodeID="N102a673084184c619a7cfeb66b284ae2"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Operador_Regar_Parcial">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="N05faf8647c184a18b6d856c38d44f7fe"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Operador_Reg"/>
    <rdfs:comment xml:lang="ca">Només es proposa si la dosi és positiva (esgotament &gt; p/2). Deixa el sol a mig camí del llindar d'estrès. Dosi = 100 x (esgotament - p/2), truncada a 0,1.</rdfs:comment>
    <rdfs:label xml:lang="ca">Operador regar-parcial</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N036e648036dd4d5597ac65eb1017d452">
    <rdf:first rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#RG1_No_Regar"/>
    <rdf:rest rdf:nodeID="N5cc48255f101467fb4132916809d90e1"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#AVR3_Sensibilitat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaReg#Font_Preferencia_Reg"/>
    <Codi_Font>AVR3-sensibilitat</Codi_Font>
    <rdfs:comment xml:lang="ca">Valor segons dom:Sensibilitat de l'Estat_Cultiu. regar-complet: +2 si alta o critica, +1 si mitja. regar-parcial: +2 si baixa. Els cultius sensibles (enciam: p petita i arrels someres, FAO-56 taula 22) millor plens; la vinya, reg deficitari (AWRI).</rdfs:comment>
  </rdf:Description>
