__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables
.env
.env.*

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Operating system
.DS_Store
Thumbs.db
desktop.ini

