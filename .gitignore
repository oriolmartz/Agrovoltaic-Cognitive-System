# CLIPS runtime persistence generated during executions
*.dat

# Experiment results are intentionally versionable for reproducibility.
# If temporary outputs are added later, place them under resultats/tmp/.
simulador/resultats/tmp/

# Generat per verificacio/e1_regressio.py a partir del RDF (no es versiona)
simulador/clips_core/topologia_rdf.clp

# E16: resultats parcials de les execucions llargues (es regeneren amb experiments.py E16 --part k)
simulador/resultats/E16/parts/

# E20: resultats parcials de les execucions llargues (es regeneren amb experiments.py E20 --part k)
simulador/resultats/E20/parts/
# Simulacions de demostracio (es regeneren executant el simulador)
simulador/resultats/simulacions/
# E23: execucions parcials i arxius d'episodis oblidats (es regeneren amb experiments.py E23)
simulador/resultats/E23/parts/
simulador/resultats/E23/arxiu/
