    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc -->

    <owl:Class rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc"/>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Agronomic -->

    <owl:Class rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Agronomic">
        <rdfs:label xml:lang="ca">Risc Agronòmic</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#activa"/>
                <owl:hasValue rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Obj_Produccio_Cultiu"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Dades -->

    <owl:Class rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Dades">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Operacional"/>
        <rdfs:comment xml:lang="ca">Lectura absent o incoherent d&apos;un sensor; origina l&apos;impasse de dades insuficients.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Estres_Hidric -->

    <owl:Class rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Estres_Hidric">
        <rdfs:label xml:lang="ca">Risc Estrès Hídric</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Agronomic"/>
        <rdfs:comment xml:lang="ca">Discretització segons l&apos;esgotament e: baix si e &lt;= p; mitja si e &lt;= p + (1-p)/3; alt si e &lt;= p + 2(1-p)/3; critic altrament.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Exces_Radiacio -->

    <owl:Class rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Exces_Radiacio">
        <rdfs:label xml:lang="ca">Risc Excès Radiació</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Agronomic"/>
        <rdfs:comment xml:lang="ca">Discretització: baix si R &lt;= Radiacio_Optima_Max; mitja si R &lt;= Radiacio_Estres; alt si R &gt; Radiacio_Estres; critic si R &gt; Radiacio_Estres i alhora el risc de temperatura és alt o critic (llum alta amb calor alta provoca dany irreversible).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Fallada_Actuador -->

    <owl:Class rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Fallada_Actuador">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Operacional"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#activa"/>
                <owl:hasValue rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Obj_Seguretat"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="ca">El panell no arriba a l&apos;angle ordenat (diferència &gt; Tolerancia_Angle després d&apos;una ordre).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Mecanic -->

    <owl:Class rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Mecanic">
        <rdfs:label xml:lang="ca">Risc Mecànic</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Operacional"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#activa"/>
                <owl:hasValue rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Obj_Seguretat"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Meteorologic_Advers -->

    <owl:Class rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Meteorologic_Advers">
        <rdfs:label xml:lang="ca">Risc meteorològic advers</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Agronomic"/>
        <rdfs:comment xml:lang="ca">Episodi meteorològic advers (pluja intensa, calamarsa) que pot malmetre el cultiu.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Operacional -->

    <owl:Class rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Operacional">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Temperatura -->

    <owl:Class rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Temperatura">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Agronomic"/>
        <rdfs:comment xml:lang="ca">Discretització: baix dins [Temp_Optima_Min, Temp_Optima_Max]; mitja fins a la meitat del marge cap al límit absolut; alt fins al límit absolut (Temp_Absoluta_Min/Max); critic fora dels límits absoluts.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sector -->

    <owl:Class rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sector">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_estat_energia"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Estat_Energia"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_panell"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Panell"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_sensor"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sensor"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_cultiu"/>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Cultiu"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_sensor"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sensor_Humitat_Sol"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_sensor"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sensor_Pluja"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_sensor"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sensor_Radiacio"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_sensor"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sensor_Temperatura_Aire"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_sensor"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sensor_Temperatura_Cultiu"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_sensor"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sensor_Vent"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


