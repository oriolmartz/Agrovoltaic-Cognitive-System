        <rdfs:label xml:lang="ca">Observació Humitat Sòl</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Observacio"/>
        <rdfs:comment xml:lang="ca">Valor = percentatge de l&apos;aigua disponible del sòl (TAW) que encara queda (0-100). Esgotament = 1 - Valor/100.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Observacio_Pluja -->

