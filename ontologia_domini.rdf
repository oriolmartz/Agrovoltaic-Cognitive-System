        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Observacio"/>
        <rdfs:comment xml:lang="ca">Valor = radiació global en W/m² (piranòmetre). Es compara amb Radiacio_Optima_Max i Radiacio_Estres del cultiu del sector.</rdfs:comment>
    </owl:Class>
    


