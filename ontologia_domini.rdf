<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#"
     xml:base="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:OntologiaModel="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#activa -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#activa">
        <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Objectiu"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#es_activat"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#afecta -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#afecta"/>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#afecta_C -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#afecta_C">
        <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Cultiu"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Agronomic"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#afecta"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#afecta_M -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#afecta_M">
        <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Panell"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Operacional"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#afecta"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#afecta_S -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#afecta_S">
        <rdfs:comment xml:lang="ca">Sensor afectat per un risc de dades (afecta_M només admet panells).</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc_Dades"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sensor"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#afecta"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#entra_conflicte -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#entra_conflicte">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Objectiu"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Objectiu"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#es_activat -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#es_activat"/>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#es_creat -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#es_creat">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#origina"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#es_detectat -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#es_detectat">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sector"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_risc"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#es_observat -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#es_observat">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#observa_a"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#mesura -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#mesura">
        <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Observacio"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sensor"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#rebre"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#observa_a -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#observa_a">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Observacio"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sector"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#origina -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#origina">
        <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Observacio"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Prediccio"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#pertany_planta -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#pertany_planta">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_sector"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#pertany_sector -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#pertany_sector">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_component"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#rebre -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#rebre">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_component -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_component"/>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_cultiu -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_cultiu">
        <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Cultiu"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sector"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_component"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_estat -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_estat"/>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_estat_cultiu -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_estat_cultiu">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Cultiu"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Estat_Cultiu"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_estat"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_estat_energia -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_estat_energia">
        <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Estat_Energia"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sector"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_estat"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_estat_panell -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_estat_panell">
        <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Estat_Panell"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Panell"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_estat"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_estat_sensor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_estat_sensor">
        <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Estat_Sensor"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sensor"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_estat"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_panell -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_panell">
        <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Panell"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sector"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_component"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_prediccio -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_prediccio">
        <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Prediccio"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sector"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_prioritat -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_prioritat">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:comment xml:lang="ca">A te_prioritat B: l&apos;objectiu A preval sobre B.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Objectiu"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Objectiu"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_risc -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_risc">
        <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sector"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_sector -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_sector">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Planta_Agrovoltaica"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sector"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_sensor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_sensor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sector"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sensor"/>
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_component"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Angle_Actual -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Angle_Actual">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Estat_Panell"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Angle_Maxim -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Angle_Maxim">
        <rdfs:comment xml:lang="ca">Angle màxim de gir del seguidor (graus). Valor +55.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Panell"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Angle_Minim -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Angle_Minim">
        <rdfs:comment xml:lang="ca">Angle mínim de gir del seguidor (graus). Valor -55.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Panell"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Angle_Optim_Produccio -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Angle_Optim_Produccio">
        <rdfs:label xml:lang="ca">Angle òptim de producció</rdfs:label>
        <rdfs:comment xml:lang="ca">Angle de màxima captació calculat externament (simulador/predicció). Entrada, no ordre. Abans: Angle_Objectiu.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Estat_Panell"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Angle_Seguretat -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Angle_Seguretat">
        <rdfs:comment xml:lang="ca">Posició de seguretat (stow), horitzontal (graus). Valor 0.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Panell"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Cicle -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Cicle">
        <rdfs:comment xml:lang="ca">Número de cicle de decisió en què es crea o actualitza el fet. Necessari per a l&apos;historial i per evitar oscil·lacions.</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Estat"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Observacio"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Prediccio"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Cicle_Ultima_Lectura -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Cicle_Ultima_Lectura">
        <rdfs:comment xml:lang="ca">Cicle de l&apos;última lectura vàlida.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Estat_Sensor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Demanda -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Demanda">
        <rdfs:comment xml:lang="ca">Quota de la demanda de la planta assignada al sector (decisió de modelatge: es manté per sector).</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Estat_Energia"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Disponible -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Disponible">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Estat_Panell"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Estat_Mecanic -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Estat_Mecanic">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Estat_Panell"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>avariat</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>degradat</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>normal</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Fase_Fenologica -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Fase_Fenologica">
        <rdfs:comment xml:lang="ca">Fase fenològica del cultiu; complementa Sensibilitat.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Estat_Cultiu"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>floracio</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>fructificacio</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>maduracio</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>repos</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                        <rdf:first>vegetativa</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Fraccio_Esgotament_p -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Fraccio_Esgotament_p">
        <rdfs:comment xml:lang="ca">Fracció de l&apos;aigua disponible al sòl que es pot esgotar sense estrès (0-1). L&apos;estrès hídric comença quan l&apos;esgotament supera p.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Cultiu"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Horitzo_Temporal -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Horitzo_Temporal">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Prediccio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Instant -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Instant">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Observacio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Nivell_Estres -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Nivell_Estres">
        <rdfs:comment xml:lang="ca">Escala simbòlica comuna: baix / mitja / alt / critic.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Estat_Cultiu"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>alt</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>baix</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>critic</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>mitja</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Nivell_Risc -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Nivell_Risc">
        <rdfs:comment xml:lang="ca">Escala simbòlica comuna: baix / mitja / alt / critic.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Risc"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>alt</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>baix</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>critic</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>mitja</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Operatiu -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Operatiu">
        <rdfs:comment xml:lang="ca">Indica si el sensor funciona.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Estat_Sensor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Produccio_Actual -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Produccio_Actual">
        <rdfs:label xml:lang="ca">Producció Actual</rdfs:label>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Estat_Energia"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Qualitat_Lectura -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Qualitat_Lectura">
        <rdfs:comment xml:lang="ca">Qualitat de l&apos;última lectura. absent/incoherent disparen l&apos;impasse de dades insuficients.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Estat_Sensor"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>absent</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>incoherent</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>valida</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Radiacio_Estres -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Radiacio_Estres">
        <rdfs:comment xml:lang="ca">Radiació global (W/m²) a partir de la qual hi ha estrès per excés de radiació. Conversió: PPFD (µmol/m²/s) ≈ 2,3 × radiació global (W/m²).</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Cultiu"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Radiacio_Optima_Max -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Radiacio_Optima_Max">
        <rdfs:comment xml:lang="ca">Radiació global (W/m²) fins a la qual el cultiu és en rang òptim. Conversió: PPFD (µmol/m²/s) ≈ 2,3 × radiació global (W/m²).</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Cultiu"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sensibilitat -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Sensibilitat">
        <rdfs:comment xml:lang="ca">Escala simbòlica comuna: baix / mitja / alt / critic.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Estat_Cultiu"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>alt</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>baix</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>critic</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>mitja</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Temp_Absoluta_Max -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Temp_Absoluta_Max">
        <rdfs:comment xml:lang="ca">Temperatura màxima tolerada (°C). Per sobre: risc critic.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Cultiu"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Temp_Absoluta_Min -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Temp_Absoluta_Min">
        <rdfs:comment xml:lang="ca">Temperatura mínima tolerada (°C). Per sota: risc critic.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Cultiu"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Temp_Optima_Max -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Temp_Optima_Max">
        <rdfs:comment xml:lang="ca">Temperatura òptima màxima (°C). Per sobre: estrès tèrmic.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Cultiu"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Temp_Optima_Min -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Temp_Optima_Min">
        <rdfs:comment xml:lang="ca">Temperatura òptima mínima (°C).</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Cultiu"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Tipus_Restriccio -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Tipus_Restriccio">
        <rdfs:comment xml:lang="ca">dura: genera preferència de rebuig/prohibició; tova: genera preferència numèrica o millor-que.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Objectiu"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first>dura</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first>tova</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Tolerancia_Angle -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Tolerancia_Angle">
        <rdfs:comment xml:lang="ca">Tolerància d&apos;angle (graus): per sota no es mou el panell; per sobre després d&apos;una ordre indica fallada d&apos;actuació. Valor 2.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Panell"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Valor -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Valor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Observacio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Valor_Previst -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Valor_Previst">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Prediccio"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Vent_Avis -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Vent_Avis">
        <rdfs:comment xml:lang="ca">Llindar de vent d&apos;avís (m/s): risc mecànic alt. Valor 12.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Panell"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Vent_Maxim_Admissible -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Vent_Maxim_Admissible">
        <rdfs:comment xml:lang="ca">Llindar de vent operatiu (m/s): risc mecànic critic, posició de seguretat obligatòria. Valor 16.</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Panell"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Cultiu -->

    <owl:Class rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Cultiu">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#te_estat_cultiu"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Estat_Cultiu"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Enciam -->

    <owl:Class rdf:about="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Enciam">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Cultiu"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Temp_Absoluta_Max"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">30.0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Temp_Absoluta_Min"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">5.0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Temp_Optima_Max"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">21.0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Radiacio_Estres"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">170.0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Temp_Optima_Min"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">12.0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Fraccio_Esgotament_p"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.3</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/maxvi/ontologies/2026/8/OntologiaModel#Radiacio_Optima_Max"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#double">170.0</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="ca">Radiació: el valor de referència és diari (DLI 17 mol/m²/dia). S&apos;aproxima a un valor instantani (≈170 W/m² de mitjana en 12 h de llum) i, com que no hi ha un segon llindar de referència, Radiacio_Estres = Radiacio_Optima_Max.</rdfs:comment>
    </owl:Class>
    


